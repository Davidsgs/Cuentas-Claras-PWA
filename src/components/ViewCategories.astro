<div id="view-categories" class="view hidden flex-col h-full flex w-full bg-base">
    <header class="bg-surface px-4 py-4 shadow-sm flex items-center gap-3 z-10 shrink-0">
        <button onclick="app.navigate('home')" class="p-2 -ml-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="arrow-left" class="w-6 h-6"></i>
        </button>
        <h2 class="text-xl font-bold">Categorías</h2>
    </header>

    <main class="flex-1 overflow-y-auto p-4 min-h-0">
        <div class="bg-gray-50 dark:bg-cardDark/50 p-4 rounded-xl mb-6 border border-dashed border-gray-300 dark:border-gray-700">
            <div class="flex gap-2">
                <input type="text" id="cat-emoji" placeholder="Icono (📦)" class="w-16 bg-white dark:bg-gray-800 rounded-xl px-3 text-center text-xl border-none focus:ring-2 focus:ring-primary outline-none" maxlength="2">
                <input type="text" id="cat-name" placeholder="Nueva Categoría" class="flex-1 bg-white dark:bg-gray-800 rounded-xl px-4 py-3 border-none focus:ring-2 focus:ring-primary outline-none">
                <button onclick="app.addCategory()" class="bg-secondary text-white p-3 rounded-xl shadow-lg shadow-emerald-500/20 ios-btn">
                    <i data-lucide="plus" class="w-6 h-6"></i>
                </button>
            </div>
        </div>
        <div id="categories-list" class="space-y-2"></div>
    </main>
</div>
