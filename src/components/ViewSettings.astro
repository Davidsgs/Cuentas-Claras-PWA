<div id="view-settings" class="view hidden flex-col h-full flex w-full bg-base">
    <header class="bg-surface pt-safe-top px-4 pb-4 shadow-sm flex items-center gap-2 z-10 shrink-0">
        <button onclick="app.navigate('home')" aria-label="Volver" class="w-11 h-11 shrink-0 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition">
            <i data-lucide="arrow-left" class="w-6 h-6"></i>
        </button>
        <h2 class="text-xl font-bold">Configuración</h2>
    </header>

    <main class="flex-1 overflow-y-auto p-4 space-y-8 min-h-0">
        <section>
            <div class="flex justify-between items-center mb-1">
                <h3 class="font-bold text-lg dark:text-gray-100">Colores</h3>
                <button onclick="app.resetColors()" class="text-primary text-sm font-medium hover:underline flex items-center gap-1">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Restaurar
                </button>
            </div>
            <p class="text-[10px] text-gray-400 italic mb-3 px-1">Los cambios del tema activo se ven al instante.</p>
            <div id="settings-colors" class="space-y-6">
                <!-- Se llena con JS -->
            </div>
        </section>

        <section class="pb-6">
            <h3 class="font-bold text-lg dark:text-gray-100 mb-3">Datos</h3>
            <div class="space-y-3">
                <button onclick="app.exportData()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition text-left">
                    <div class="bg-indigo-100 dark:bg-indigo-900/30 p-3 rounded-full text-primary shrink-0">
                        <i data-lucide="download" class="w-6 h-6"></i>
                    </div>
                    <div class="min-w-0">
                        <h4 class="font-bold text-gray-900 dark:text-white">Exportar todo</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Cuentas, carpetas, categorías y colores en un JSON</p>
                    </div>
                </button>

                <button onclick="document.getElementById('import-file').click()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition text-left">
                    <div class="bg-emerald-100 dark:bg-emerald-900/30 p-3 rounded-full text-secondary shrink-0">
                        <i data-lucide="upload" class="w-6 h-6"></i>
                    </div>
                    <div class="min-w-0">
                        <h4 class="font-bold text-gray-900 dark:text-white">Importar desde JSON</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Las cuentas del archivo entran agrupadas en una carpeta nueva</p>
                    </div>
                </button>
            </div>
            <input type="file" id="import-file" accept="application/json,.json" class="hidden" onchange="app.importData(this)">
            <p class="text-[10px] text-gray-400 italic mt-3 px-1">Importar no borra nada: lo que ya tienes se conserva tal cual.</p>
        </section>
    </main>
</div>
