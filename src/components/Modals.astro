<!-- Export Modal -->
<div id="modal-export" data-close="closeExportModal" class="fixed inset-0 z-[80] bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300" id="modal-export-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeExportModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        <h2 class="text-xl font-bold mb-4 text-content">Exportar Detalle</h2>
        <div class="space-y-3">
            <button id="export-share-btn" class="w-full flex items-center gap-4 p-4 rounded-xl bg-content/5 hover:bg-content/10 transition group">
                <div class="bg-primary/15 p-3 rounded-full text-primary">
                    <i data-lucide="qr-code" class="w-6 h-6"></i>
                </div>
                <div class="text-left min-w-0">
                    <h4 class="font-bold text-content">Compartir con alguien</h4>
                    <p class="text-xs text-muted">QR o enlace para que la copie en su app</p>
                </div>
            </button>

            <button onclick="app.exportText()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-content/5 hover:bg-content/10 transition group">
                <div class="bg-primary/15 p-3 rounded-full text-primary">
                    <i data-lucide="file-text" class="w-6 h-6"></i>
                </div>
                <div class="text-left">
                    <h4 class="font-bold text-content">Como Texto</h4>
                    <p class="text-xs text-muted">Copiar al portapapeles o WhatsApp</p>
                </div>
            </button>
            
            <button onclick="app.exportImage()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-content/5 hover:bg-content/10 transition group">
                <div class="bg-secondary/15 p-3 rounded-full text-secondary">
                    <i data-lucide="image" class="w-6 h-6"></i>
                </div>
                <div class="text-left">
                    <h4 class="font-bold text-content">Como Imagen</h4>
                    <p class="text-xs text-muted">Descargar resumen visual (PNG)</p>
                </div>
            </button>
            
            <button onclick="app.exportPDF()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-content/5 hover:bg-content/10 transition group">
                <div class="bg-danger/15 p-3 rounded-full text-danger">
                    <i data-lucide="file" class="w-6 h-6"></i>
                </div>
                <div class="text-left">
                    <h4 class="font-bold text-content">Como PDF</h4>
                    <p class="text-xs text-muted">Documento estilo hoja A4</p>
                </div>
            </button>
        </div>
        <button onclick="app.closeExportModal()" class="w-full mt-6 text-muted py-3 font-medium">Cancelar</button>
    </div>
</div>

<!-- Add Account -->
<div id="modal-add-account" data-close="closeAddAccountModal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300" id="modal-add-account-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeAddAccountModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        <h2 id="add-account-title" class="text-xl font-bold mb-4">Nueva Cuenta</h2>
        <div class="space-y-4">
            <input type="text" id="new-account-name" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary" placeholder="Nombre (ej. Playa)">
            <select id="new-account-cat" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary appearance-none"></select>
            <div>
                <label class="text-xs text-muted font-medium ml-1">Fecha del Evento (Opcional)</label>
                <input type="date" id="new-account-date" class="w-full mt-1 bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-content">
            </div>
            <button id="add-account-submit" onclick="app.saveAccount()" class="w-full bg-primary text-on-primary py-3.5 rounded-xl font-bold shadow-lg mt-2">Crear</button>
            <button onclick="app.closeAddAccountModal()" class="w-full text-muted py-3 font-medium">Cancelar</button>
        </div>
    </div>
</div>

<!-- Participante: crear, editar y borrar -->
<div id="modal-add-participant" data-close="closeAddParticipantModal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full max-w-sm rounded-2xl p-6 transform scale-95 transition-transform duration-200 max-h-[90vh] overflow-y-auto" id="modal-add-participant-panel">
        <h3 id="part-title" class="text-lg font-bold mb-4 text-content">Nuevo Participante</h3>
        <input type="text" id="part-name" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-content" placeholder="Nombre (ej. Juan)">

        <details id="part-advanced" class="group mt-3 rounded-xl border border-line overflow-hidden">
            <summary class="flex items-center gap-2 p-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <i data-lucide="landmark" class="w-4 h-4 text-muted shrink-0"></i>
                <span class="text-sm font-bold text-content flex-1">Avanzado</span>
                <span class="text-[10px] text-muted">Datos para transferirle</span>
                <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="p-3 pt-0 space-y-3">
                <input type="text" id="part-bank" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-content" placeholder="Banco (ej. Galicia)">
                <input type="text" id="part-cbu" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-content" placeholder="CBU o Alias">
                <label id="part-save-contact-row" class="flex items-center gap-2 p-2 rounded-lg bg-content/5 border border-line cursor-pointer">
                    <input type="checkbox" id="part-save-contact" class="w-5 h-5 rounded text-primary focus:ring-primary">
                    <span class="text-sm text-content flex-1">Guardar en frecuentes</span>
                </label>
                <p class="text-[10px] text-muted italic">Los frecuentes se reusan en otras cuentas y se gestionan desde Configuración.</p>
            </div>
        </details>

        <div class="flex gap-3 mt-4">
            <button onclick="app.closeAddParticipantModal()" class="flex-1 py-3 text-muted font-medium hover:bg-content/10 rounded-xl transition">Cancelar</button>
            <button id="part-save" onclick="app.saveParticipant()" class="flex-1 py-3 bg-primary text-on-primary font-bold rounded-xl shadow-lg hover:bg-primary/90 transition">Añadir</button>
        </div>
        <button id="part-delete" onclick="app.deleteParticipant()" class="hidden w-full mt-2 py-3 text-danger font-medium rounded-xl hover:bg-danger/10 transition items-center justify-center gap-2">
            <i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar participante
        </button>
    </div>
</div>

<!-- Libreta de frecuentes: elegir a quien sumar a la cuenta -->
<div id="modal-contacts" data-close="closeContactsModal" class="fixed inset-0 z-[80] bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300 max-h-[90vh] overflow-y-auto" id="modal-contacts-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeContactsModal" aria-hidden="true">
            <div class="w-12 h-1 bg-content/20 rounded-full"></div>
        </div>
        <h2 class="text-xl font-bold text-content">Frecuentes</h2>
        <p class="text-sm text-muted mb-4">Tócalos para sumarlos a esta cuenta</p>
        <input type="text" id="contacts-search" oninput="app.renderContactsPicker()" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-content mb-4" placeholder="Buscar…">
        <div id="contacts-picker" class="space-y-2"></div>
        <button onclick="app.closeContactsModal()" class="w-full mt-6 text-muted py-3 font-medium">Cerrar</button>
    </div>
</div>

<!-- Add Expense -->
<div id="modal-add-expense" data-close="closeAddExpenseModal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300" id="modal-add-expense-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeAddExpenseModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        <h2 id="add-expense-title" class="text-xl font-bold mb-4">Nuevo Gasto</h2>
        <div class="space-y-4">
            <input type="text" id="exp-desc" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary" placeholder="Descripción (ej. Cervezas)">
            <input type="number" id="exp-amount" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-lg font-bold" placeholder="$0.00">
            <div>
                <label class="text-xs text-muted font-medium ml-1">¿Quién pagó?</label>
                <select id="exp-payer" class="w-full mt-1 bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary appearance-none"></select>
            </div>
            <div>
                <label class="text-xs text-muted font-medium ml-1">Fecha del Gasto (Opcional)</label>
                <input type="date" id="exp-date" class="w-full mt-1 bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary text-content">
            </div>
            
            <!-- TIPO DE GASTO -->
            <div class="pt-2">
                <div class="flex items-center gap-2 mb-2 cursor-pointer bg-content/5 p-2 rounded-lg border border-line" onclick="document.getElementById('exp-is-personal').click()">
                    <input type="checkbox" id="exp-is-personal" class="w-5 h-5 rounded text-primary focus:ring-primary border-line pointer-events-none" onchange="app.toggleExpenseType()">
                    <label class="text-sm font-medium text-content select-none cursor-pointer flex-1">¿Es un gasto personal?</label>
                </div>
                
                <div id="exp-beneficiary-wrapper" class="hidden animate-fade-in pl-2 border-l-2 border-primary ml-1">
                    <label class="text-xs text-muted font-medium ml-1">¿Para quién es (Beneficiario)?</label>
                    <select id="exp-beneficiary" class="w-full mt-1 bg-primary/10 border border-primary/30 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary appearance-none text-primary font-bold"></select>
                    <p class="text-[10px] text-muted mt-1 ml-1">Este monto se cobrará 100% a esta persona.</p>
                </div>
            </div>

            <button id="add-expense-submit" onclick="app.saveExpense()" class="w-full bg-primary text-on-primary py-3.5 rounded-xl font-bold shadow-lg mt-2">Guardar Gasto</button>
            <button onclick="app.closeAddExpenseModal()" class="w-full text-muted py-3 font-medium">Cancelar</button>
        </div>
    </div>
</div>

<!-- Modal Balances (Resultados) -->
<div id="modal-balances" data-close="closeBalancesModal" class="fixed inset-0 z-[60] bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300 max-h-[90vh] overflow-y-auto flex flex-col" id="modal-balances-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeBalancesModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        
        <div class="flex justify-between items-start mb-6 shrink-0">
            <div>
                <h2 class="text-xl font-bold text-content">División de Gastos</h2>
                <p class="text-sm text-muted">Quién le paga a quién</p>
            </div>
            <button onclick="app.closeBalancesModal()" class="p-2 -mr-2 text-muted hover:text-muted">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>

        <div class="bg-primary/10 rounded-xl p-4 mb-6 shrink-0 text-center border border-primary/30">
            <p class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Cuota Grupal (Promedio)</p>
            <h3 id="bal-share" class="selectable text-3xl font-bold text-content">$0</h3>
            <p class="text-[10px] text-muted mt-1 italic">Más gastos particulares individuales</p>
        </div>

        <h3 class="font-bold text-content mb-3 shrink-0">Deudas Pendientes</h3>
        <div id="bal-list" class="selectable space-y-3 overflow-y-auto pb-4"></div>
    </div>
</div>

<!-- Mover cuentas a una carpeta -->
<div id="modal-move" data-close="closeMoveModal" class="fixed inset-0 z-[80] bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300" id="modal-move-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeMoveModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        <h2 id="move-title" class="text-xl font-bold mb-4 text-content">Mover a…</h2>
        <div id="move-list" class="space-y-3 max-h-[50vh] overflow-y-auto"></div>
        <button onclick="app.closeMoveModal()" class="w-full mt-6 text-muted py-3 font-medium">Cancelar</button>
    </div>
</div>

<!-- Pedir un texto (renombrar carpeta, nombrar una carpeta nueva) -->
<div id="modal-prompt" data-close="closePrompt" class="fixed inset-0 z-[85] bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-200">
    <div class="bg-surface w-full max-w-sm rounded-2xl shadow-2xl p-6 transform scale-95 transition-transform duration-200" id="modal-prompt-panel">
        <h3 id="prompt-title" class="text-lg font-bold mb-4 text-content">Nombre</h3>
        <input type="text" id="prompt-input" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary mb-4 text-content" placeholder="Nombre">
        <div class="flex gap-3">
            <button onclick="app.closePrompt()" class="flex-1 py-3 text-muted font-medium hover:bg-content/10 rounded-xl transition">Cancelar</button>
            <button id="prompt-ok" class="flex-1 py-3 bg-primary text-on-primary font-bold rounded-xl shadow-lg hover:bg-primary/90 transition">Guardar</button>
        </div>
    </div>
</div>

<!-- Editor de tema: sirve para crear y para editar -->
<div id="modal-theme" data-close="closeThemeModal" class="fixed inset-0 z-[80] bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300 max-h-[90vh] overflow-y-auto" id="modal-theme-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeThemeModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        <h2 id="theme-modal-title" class="text-xl font-bold mb-4 text-content">Nuevo Tema</h2>
        <input type="text" id="theme-name" placeholder="Nombre del tema" aria-label="Nombre del tema" class="w-full bg-content/10 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary mb-4 text-content">
        <div id="theme-colors" class="space-y-2"></div>
        <button id="theme-save" class="w-full bg-primary text-on-primary py-3.5 rounded-xl font-bold shadow-lg mt-4">Guardar</button>
        <button onclick="app.closeThemeModal()" class="w-full text-muted py-3 font-medium">Cancelar</button>
    </div>
</div>

<!-- Compartir cuenta o carpeta -->
<div id="modal-share" data-close="closeShareModal" class="fixed inset-0 z-[80] bg-black/50 backdrop-blur-sm hidden flex items-end sm:items-center justify-center sm:p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-surface w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl p-6 transform translate-y-full sm:translate-y-0 transition-transform duration-300 max-h-[90vh] overflow-y-auto" id="modal-share-panel">
        <div class="sheet-grab -mx-6 -mt-6 mb-4 pt-3 pb-3 flex items-start justify-center sm:hidden" data-close="closeShareModal" aria-hidden="true"><div class="w-12 h-1 bg-content/20 rounded-full"></div></div>
        <h2 id="share-title" class="text-xl font-bold text-content">Compartir</h2>
        <p id="share-sub" class="text-sm text-muted mb-4">&nbsp;</p>

        <!-- El QR va siempre en negro sobre blanco: con los colores del tema
             un tema oscuro lo invierte y deja de escanearse. -->
        <div id="share-qr-wrap" class="bg-white rounded-2xl p-4 mb-3 mx-auto max-w-[19rem]">
            <div id="share-qr" class="w-full aspect-square"></div>
        </div>
        <p id="share-qr-hint" class="text-xs text-muted text-center mb-4">Apunta la cámara del otro teléfono. No hace falta escanear desde la app.</p>
        <div id="share-too-big" class="hidden bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-4">
            <p class="text-xs text-amber-500">Son demasiados datos para un QR. Usa el enlace o el archivo.</p>
        </div>

        <div class="space-y-3">
            <button onclick="app.shareLink()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-content/5 hover:bg-content/10 transition text-left">
                <div class="bg-primary/15 p-3 rounded-full text-primary shrink-0"><i data-lucide="link" class="w-6 h-6"></i></div>
                <div class="min-w-0">
                    <h4 class="font-bold text-content">Compartir enlace</h4>
                    <p class="text-xs text-muted">Por WhatsApp, mail o lo que uses</p>
                </div>
            </button>
            <button onclick="app.shareFile()" class="w-full flex items-center gap-4 p-4 rounded-xl bg-content/5 hover:bg-content/10 transition text-left">
                <div class="bg-secondary/15 p-3 rounded-full text-secondary shrink-0"><i data-lucide="file-text" class="w-6 h-6"></i></div>
                <div class="min-w-0">
                    <h4 class="font-bold text-content">Compartir archivo</h4>
                    <p class="text-xs text-muted">Un JSON que se importa desde Configuración</p>
                </div>
            </button>
        </div>
        <button onclick="app.closeShareModal()" class="w-full mt-6 text-muted py-3 font-medium">Cerrar</button>
    </div>
</div>

<!-- Aviso de versión nueva -->
<div id="update-bar" class="fixed bottom-0 inset-x-0 z-[95] hidden p-4 pointer-events-none">
    <div class="bg-surface border border-line rounded-2xl shadow-2xl p-4 max-w-md mx-auto pointer-events-auto">
        <div class="flex items-start gap-3">
            <div class="bg-primary/15 text-primary p-2 rounded-full shrink-0">
                <i data-lucide="rotate-ccw" class="w-5 h-5"></i>
            </div>
            <div class="min-w-0">
                <h4 id="update-title" class="font-bold text-sm text-content">Hay una versión nueva</h4>
                <p id="update-sub" class="text-xs text-muted">Se aplica al recargar. Tus cuentas no se tocan.</p>
            </div>
        </div>
        <div class="flex gap-2 mt-3">
            <button onclick="app.dismissUpdate()" class="flex-1 py-2.5 rounded-xl text-muted font-medium text-sm hover:bg-content/10 transition">Después</button>
            <button id="update-now" class="flex-1 py-2.5 rounded-xl bg-primary text-on-primary font-bold text-sm shadow-lg shadow-primary/30">Actualizar</button>
        </div>
    </div>
</div>

<!-- Toast & Confirm -->
<div id="toast" class="fixed top-4 left-1/2 transform -translate-x-1/2 bg-content text-base px-6 py-3 rounded-full shadow-xl z-[60] text-sm font-medium opacity-0 pointer-events-none transition duration-300 flex items-center gap-2">
    <i data-lucide="info" class="w-4 h-4 text-secondary"></i>
    <span id="toast-msg">Mensaje</span>
</div>

<div id="modal-confirm" data-close="closeConfirm" class="fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-200">
    <div class="bg-surface rounded-2xl shadow-2xl max-w-sm w-full p-6 transform scale-95 transition-transform duration-200" id="modal-panel">
        <div class="w-12 h-12 rounded-full bg-danger/15 flex items-center justify-center mb-4 text-danger">
            <i data-lucide="alert-triangle" class="w-6 h-6"></i>
        </div>
        <h3 class="text-lg font-bold mb-2 text-content">¿Estás seguro?</h3>
        <p id="modal-msg" class="text-muted mb-6 text-sm leading-relaxed">Esta acción no se puede deshacer.</p>
        <div class="flex gap-3">
            <button onclick="app.closeConfirm()" class="flex-1 py-3 rounded-xl bg-content/10 text-content font-medium hover:bg-content/20 transition">Cancelar</button>
            <button id="modal-btn-yes" class="flex-1 py-3 rounded-xl bg-danger text-white font-bold shadow-lg hover:bg-red-600 transition">Eliminar</button>
        </div>
    </div>
</div>
