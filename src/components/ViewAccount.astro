<div id="view-account" class="view hidden flex-col h-full flex w-full bg-base">
    <header class="bg-surface px-4 py-4 shadow-sm flex items-center justify-between z-10 shrink-0">
        <div class="flex items-center gap-3">
            <button onclick="app.navigate('home')" class="p-2 -ml-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700">
                <i data-lucide="arrow-left" class="w-6 h-6"></i>
            </button>
            <div>
                <h2 id="acc-title" class="text-xl font-bold leading-tight truncate max-w-[150px]">Cuenta</h2>
                <p id="acc-meta" class="text-xs text-gray-500 dark:text-gray-400">Detalles</p>
            </div>
        </div>
        <div class="flex gap-2">
            <!-- Botón Exportar -->
            <button onclick="app.showExportModal()" class="p-2 rounded-full hover:bg-indigo-50 text-gray-400 hover:text-primary dark:hover:bg-indigo-900/20 transition" title="Exportar Resumen">
                <i data-lucide="share-2" class="w-5 h-5"></i>
            </button>
            <!-- Botón Eliminar -->
            <button onclick="app.deleteCurrentAccount()" class="p-2 rounded-full hover:bg-red-50 text-gray-400 hover:text-red-500 dark:hover:bg-red-900/20 transition">
                <i data-lucide="trash-2" class="w-5 h-5"></i>
            </button>
        </div>
    </header>

    <!-- Main con min-h-0 para permitir scroll flex -->
    <main class="flex-1 overflow-y-auto p-4 space-y-6 min-h-0">
        <!-- Resumen Total -->
        <div class="bg-primary text-white rounded-2xl p-6 shadow-lg shadow-primary/20 relative overflow-hidden mb-2">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
            
            <!-- Total Grupal (Principal) -->
            <p class="text-indigo-100 text-sm font-medium mb-1">Gasto Grupal</p>
            <h3 id="acc-total-group" class="text-4xl font-bold tracking-tight">$0</h3>
            
            <!-- Total General (Secundario) -->
            <div class="mt-3 pt-3 border-t border-white/20 flex items-center justify-between text-xs text-indigo-100">
                <span>Total General (con personales):</span>
                <span id="acc-total-all" class="font-bold text-white text-sm">$0</span>
            </div>
        </div>

        <!-- BOTÓN NUEVO GASTO -->
        <button onclick="app.showAddExpenseModal()" class="w-full bg-primary text-white py-3.5 rounded-xl font-bold shadow-lg shadow-primary/30 ios-btn flex items-center justify-center gap-2">
            <i data-lucide="receipt" class="w-5 h-5"></i>
            Nuevo Gasto
        </button>

        <!-- Sección Participantes -->
        <div>
            <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-lg dark:text-gray-100">Participantes</h3>
                <button onclick="app.showAddParticipantModal()" class="text-primary text-sm font-medium hover:underline flex items-center gap-1">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i> Agregar
                </button>
            </div>
            <!-- pt-2 para dar espacio al botón de borrar -->
            <div id="acc-participants" class="flex gap-2 overflow-x-auto py-2 hide-scrollbar">
                <!-- Se llena con JS -->
            </div>
            <p class="text-[10px] text-gray-400 mt-1 italic px-1">Toca un participante para eliminarlo</p>
        </div>

        <!-- Sección Gastos y Pagos -->
        <div class="pb-6">
             <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-lg dark:text-gray-100">Historial</h3>
            </div>
            <p class="text-[10px] text-gray-400 -mt-2 mb-3 italic px-1">Toca un gasto para editarlo</p>
            <div id="acc-expenses" class="space-y-3">
                <!-- Se llena con JS -->
            </div>
        </div>
    </main>

    <!-- Botón Calcular (Parte del flujo flex) -->
    <div class="p-4 bg-surface border-t border-gray-100 dark:border-gray-800 w-full shrink-0 z-20">
        <button onclick="app.calculateBalances()" class="w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 py-3 rounded-xl font-bold shadow-sm flex items-center justify-center gap-2 hover:bg-gray-50 dark:hover:bg-gray-700 transition ios-btn">
            <i data-lucide="calculator" class="w-5 h-5 text-primary"></i>
            Calcular División
        </button>
    </div>
</div>
