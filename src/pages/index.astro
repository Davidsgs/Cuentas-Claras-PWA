---
import Base from '../layouts/Base.astro';
import ViewHome from '../components/ViewHome.astro';
import ViewAccount from '../components/ViewAccount.astro';
import ViewSettings from '../components/ViewSettings.astro';
import Modals from '../components/Modals.astro';
---

<Base>
    <ViewHome />
    <ViewAccount />
    <ViewSettings />
    <Modals />
</Base>

<script>
    import { registerSW } from 'virtual:pwa-register';
    import '../scripts/app.js';

    // La versión nueva queda esperando; onNeedRefresh avisa y la barra deja que
    // el usuario elija el momento. updateSW(true) recarga.
    const updateSW = registerSW({
        immediate: true,
        onNeedRefresh() { window.app.showUpdateBar(() => updateSW(true)); }
    });
</script>
